/* 页面背景 */
page {
  background-color: #f5f5f5;
}

/* ==================== 1. 登录面板样式 ==================== */
.myLogin {
  height: 400rpx;
  background-color: #328EEB;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 已登录状态：头像与昵称展示 */
.myLogin-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
}

.myLogin-name {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  margin-top: 15rpx;
}

/* 未登录状态：授权登录面板容器 */
.login-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头像获取按钮重置样式 */
.avatar-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: normal;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #ffffff;
  border: 3rpx solid rgba(255, 255, 255, 0.8);
}

.avatar-tip {
  font-size: 22rpx;
  color: #e0f0ff;
  margin-top: 8rpx;
}

/* 微信昵称输入框 */
.nickname-input {
  background-color: #ffffff;
  width: 320rpx;
  height: 60rpx;
  border-radius: 30rpx;
  text-align: center;
  font-size: 26rpx;
  margin: 15rpx 0;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.login-btn {
  margin-top: 5rpx;
}

/* ==================== 2. 我的收藏列表样式 ==================== */
.myFavorites {
  background-color: #ffffff;
  margin-top: 20rpx;
  padding: 20rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  padding: 0 30rpx 15rpx 30rpx;
  border-bottom: 1rpx solid #eeeeee;
  color: #333333;
}

.news-list {
  min-height: 120rpx;
}

.news-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.news-item:active {
  background-color: #f9f9f9;
}

.news-item image {
  width: 180rpx;
  height: 120rpx;
  margin-right: 20rpx;
  border-radius: 8rpx;
  flex-shrink: 0; /* 防止弹性盒挤压图片变形 */
}

.news-item text {
  font-size: 28rpx;
  color: #333333;
  line-height: 42rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 暂无收藏提示 */
.empty-tip {
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  padding: 40rpx 0;
}

/* ==================== 3. 服务菜单栏样式 ==================== */
.menu-list {
  margin-top: 20rpx;
  background-color: #ffffff;
}

.menu-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #eeeeee;
  font-size: 30rpx;
  color: #333333;
}

.menu-item:active {
  background-color: #f9f9f9;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-left .icon {
  margin-right: 15rpx;
  font-size: 32rpx;
}

.arrow {
  color: #ccc;
  font-size: 30rpx;
}