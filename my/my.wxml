<!-- 登录面板（支持快捷选择微信头像和昵称） -->
<view class="myLogin">
  <!-- 已登录状态 -->
  <block wx:if="{{isLogin}}">
    <image class="myLogin-img" src="{{src}}"></image>
    <text class="myLogin-name">{{nickName}}</text>
  </block>
  
  <!-- 未登录状态：自定义微信头像与昵称输入 -->
  <block wx:else>
    <view class="login-box">
      <!-- 快捷获取/选择微信头像按钮 -->
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar-img" src="{{src || '/images/my.png'}}"></image>
        <text class="avatar-tip">点击获取微信头像</text>
      </button>
      
      <!-- 快捷获取/输入微信昵称 -->
      <input type="nickname" class="nickname-input" placeholder="点击选择或输入昵称" bindchange="onInputNickname" value="{{nickName}}" />
      
      <!-- 确认登录按钮 -->
      <button type="primary" size="mini" class="login-btn" bindtap="loginWithCustomInfo">确认登录</button>
    </view>
  </block>
</view>

<!-- 我的收藏列表 -->
<view class="myFavorites">
  <view class="section-title">❤️ 我的收藏 ({{num}})</view>
  <view class="news-list">
    <view class="news-item" wx:for="{{newsList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <image src="{{item.poster}}"></image>
      <text>◇ {{item.title}}——{{item.add_date}}</text>
    </view>
    <view wx:if="{{newsList.length == 0}}" class="empty-tip">暂无收藏的新闻</view>
  </view>
</view>

<!-- 服务菜单栏 -->
<view class="menu-list">
  <!-- 清除本地缓存按钮 -->
  <view class="menu-item" bindtap="clearStorage">
    <view class="menu-left">
      <text class="icon">🗑️</text>
      <text>清除本地缓存</text>
    </view>
    <text class="arrow">＞</text>
  </view>

  <!-- 关于我们按钮 -->
  <view class="menu-item" bindtap="showAbout">
    <view class="menu-left">
      <text class="icon">ℹ️</text>
      <text>关于我们</text>
    </view>
    <text class="arrow">＞</text>
  </view>
</view>