/* 0 页面整体背景 */
page {
  background-color: #f5f5f5;
}

/* 顶部搜索栏 */
.search-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 15rpx 20rpx;
  background-color: #328EEB;
}

.search-bar input {
  flex: 1;
  height: 65rpx;
  background-color: #ffffff;
  border-radius: 30rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
}

.search-bar button {
  margin-left: 15rpx;
  background-color: #ffffff;
  color: #328EEB;
  border-radius: 30rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
  line-height: 60rpx;
}

/* 1-1 幻灯片容器 */
swiper {
  height: 400rpx;
  width: 100%;
  background-color: #f0f0f0; /* 添加背景色防止图片未加载时留白 */
}

/* 1-2 幻灯片图片 */
swiper image {
  width: 100%;
  height: 100%;
}

/* 2-1 新闻列表容器 */
#news-list {
  min-height: 600rpx;
  padding: 15rpx;
  background-color: #ffffff;
}

/* 2-2 列表项目 */
.list-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 1rpx solid #eeeeee;
  padding: 15rpx 0;
}

.list-item:active {
  background-color: #f9f9f9;
}

/* 2-3 新闻图片 */
.list-item image {
  width: 230rpx;
  height: 150rpx;
  margin-right: 20rpx;
  flex-shrink: 0; /* 防止图片被右侧文字挤压变形 */
  border-radius: 8rpx;
}

/* 2-4 新闻标题 */
.list-item text {
  width: 100%;
  line-height: 45rpx;
  font-size: 10pt;
  color: #333333;
}

/* 无搜索结果提示 */
.empty-tip {
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  padding: 60rpx 0;
}